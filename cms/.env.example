# CMS (Payload) — variáveis de ambiente.
#
# Os valores reais vivem em `cms/.env.local` (desenvolvimento) ou nas
# definições do projeto na Vercel (produção). Este ficheiro tem apenas os NOMES.
#
# ATENÇÃO, VERCEL: as variáveis são congeladas no momento em que o deployment é
# criado. Defini-las depois não tem efeito nenhum sem reconstruir. Verificado
# experimentalmente neste projeto.


# ============================== OBRIGATÓRIAS ==============================

# Ligação ao Postgres.
#
# Tem de ser o SESSION POOLER (porta 5432). O pooler de transacções (6543) não
# suporta prepared statements, e o Drizzle — que o Payload usa nas migrações —
# depende deles.
#
# Obtém-se em: Supabase → Connect → separador "Session pooler".
# Se a password tiver símbolos, codificar em percentagem (@ = %40).
#
# ATENÇÃO: em desenvolvimento nunca apontar para a base de dados de produção.
DATABASE_URL=

# Assina os tokens de sessão do painel. Qualquer cadeia longa e aleatória.
# Trocá-la invalida todas as sessões abertas.
PAYLOAD_SECRET=


# ========================= PRODUÇÃO: RECOMENDADAS =========================

# Endereço público do painel, para as ligações nos emails de recuperação de
# password saírem certas. Ex.: https://cms.way2go.pt
# Sem isto, a Vercel usa o VERCEL_URL do deployment, que muda a cada build.
PAYLOAD_PUBLIC_SERVER_URL=

# Tecto de ligações por instância. Em serverless cada invocação tem o seu pool;
# sem tecto, instâncias em paralelo esgotam as ligações do Supabase.
DATABASE_POOL_MAX=


# ------------------------------- Email -----------------------------------
#
# Sem isto, o Payload escreve os emails na consola e a RECUPERAÇÃO DE PASSWORD
# DEIXA DE FUNCIONAR. Em produção, isso significa poder ficar fechado de fora
# sem forma de voltar a entrar.
#
# Há dois caminhos e o Resend tem precedência. O SMTP fica escrito para o dia
# em que o email do site for corrigido — nessa altura o CMS aproveita sem
# precisar de alteração nenhuma.
#
# Nota: as variáveis SMTP do site existem na Vercel desde há meses COM OS
# VALORES VAZIOS, e não há Resend nem SendGrid configurados. O site não
# consegue enviar email. Está por resolver, e é independente do CMS.

# Resend — o caminho escolhido. Chave em resend.com → API Keys.
RESEND_API_KEY=
# Remetente. Com domínio verificado no Resend, algo como cms@way2go.pt.
# Sem domínio verificado, o Resend só deixa enviar de onboarding@resend.dev
# e só para o email da própria conta.
EMAIL_FROM=
EMAIL_FROM_NAME=

# SMTP — alternativa, usada apenas se não houver RESEND_API_KEY.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=


# --------------------- Imagens: Supabase Storage (S3) ---------------------
#
# Sem estas variáveis, os ficheiros vão para o disco local (`cms/media/`), o que
# serve em desenvolvimento e NÃO SERVE em Vercel — lá não há disco, e o ficheiro
# é escrito e desaparece sem dar erro.
#
# Obtêm-se em: Supabase → Storage → S3 Access Keys. O secret só aparece uma vez.
# Usar baldes diferentes em desenvolvimento e em produção.
S3_BUCKET=
# Ex.: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Opcional. Endereço público das imagens, se não for o do Supabase.
# Por omissão deriva do S3_ENDPOINT trocando "/s3" por "/object/public", o que
# está certo para o Supabase e não serve para outro fornecedor.
#
# As imagens são servidas directamente por este endereço, não através do
# Payload: o balde é público, e passá-las pela aplicação seria uma invocação
# da Vercel por fotografia para transportar bytes que o CDN entrega melhor.
S3_PUBLIC_BASE_URL=
